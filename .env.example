# Supabase Environment Variables
# Get these from your Supabase project dashboard

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_APP_URL=http://localhost:8080

# Optional legacy alias. Prefer VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase Edge Function secret, not a Vite/frontend variable.
# Set it in Supabase secrets, never in frontend code:
# supabase secrets set MISTRAL_API_KEY=...
MISTRAL_API_KEY=

# REQUIRED: Enable OAuth Providers in Supabase Dashboard:
# 1. Authentication → Providers
# 2. Enable "GitHub" → Add GitHub OAuth App credentials
# 3. Enable "Google" → Add Google OAuth 2.0 credentials
# 4. Set "Redirect URLs" to: http://localhost:3000/auth/callback (dev) + your production domain

# GitHub OAuth App Setup:
# https://github.com/settings/applications/new
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/auth/callback

# Google OAuth Setup:
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs: http://localhost:3000/auth/callback

# Copy these values to .env.local (gitignored)
